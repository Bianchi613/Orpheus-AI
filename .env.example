# Copie este arquivo para .env e escolha um provedor.
AI_PROVIDER=ollama

# Ollama local
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI externa (use AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Executor
AI_AUTO_APPROVE=0
AI_SELF_MODIFY=0
AI_MAX_STEPS=30
AI_COMMAND_TIMEOUT=60
AI_MAX_OUTPUT=12000
# AI_PROMPT_FILE=
# deixe vazio para usar o prompt padrão ao lado do ai.py
